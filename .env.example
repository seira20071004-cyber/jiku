# Optional Google OAuth mode for a server deployment.
# Keep these values in the hosting provider's secret settings, never in Git.
JIKU_AUTH_MODE=google
JIKU_AUTH_ORIGIN=https://jiku-life-tree.seira20071004.chatgpt.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JIKU_SESSION_SECRET=
# Initially allow only the owner's Google account. Comma-separated email list.
JIKU_ALLOWED_EMAILS=
# Register the exact redirect URI in Google Cloud:
# https://jiku-life-tree.seira20071004.chatgpt.site/api/auth/google/callback
